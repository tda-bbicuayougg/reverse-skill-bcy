{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VulnerabilityHypothesisSchema",
  "type": "object",
  "required": ["hypothesis_id", "suspected_vulnerability", "affected_asset_id", "supporting_observations", "status"],
  "properties": {
    "hypothesis_id": { "type": "string" },
    "suspected_vulnerability": { "type": "string" },
    "affected_asset_id": { "type": "string" },
    "supporting_observations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_plan": {
      "type": "object",
      "properties": {
        "validation_command": { "type": ["string", "null"] },
        "disproof_criteria": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["CANDIDATE", "VALIDATING", "CONFIRMED", "REJECTED", "INCONCLUSIVE"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  }
}

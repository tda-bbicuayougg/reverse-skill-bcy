{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiskModelSchema",
  "type": "object",
  "required": ["severity", "confidence", "exploitability", "business_impact", "composite_score"],
  "properties": {
    "severity": { "type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "exploitability": { "type": "string", "enum": ["UNPROVEN", "POC_EXISTS", "ACTIVE_EXPLOIT", "AUTOMATED"] },
    "business_impact": { "type": "string", "enum": ["NONE", "LOW", "MODERATE", "HIGH", "SEVERE"] },
    "composite_score": { "type": "number", "minimum": 0.0, "maximum": 10.0 }
  }
}

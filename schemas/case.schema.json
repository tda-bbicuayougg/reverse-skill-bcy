{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaseSchema",
  "type": "object",
  "required": ["case_id", "fingerprint", "workflow", "evidence", "status"],
  "properties": {
    "case_id": { "type": "string" },
    "fingerprint": { "$ref": "fingerprint.schema.json" },
    "workflow": {
      "type": "array",
      "items": { "type": "string" }
    },
    "successful_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failed_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "status": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "VALIDATED", "CLOSED"] }
  }
}

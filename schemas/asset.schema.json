{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssetSchema",
  "type": "object",
  "required": ["asset_id", "type", "source", "confidence"],
  "properties": {
    "asset_id": { "type": "string" },
    "type": { "type": "string", "enum": ["domain", "host", "service", "application", "api_endpoint", "identity", "cloud_resource", "container", "mobile_client", "firmware"] },
    "source": { "type": "string" },
    "value": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "in_scope": { "type": "boolean" },
    "observed_at": { "type": "string" },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_asset_id", "relation_type"],
        "properties": {
          "target_asset_id": { "type": "string" },
          "relation_type": { "type": "string" }
        }
      }
    }
  }
}
